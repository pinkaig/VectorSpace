            {
              "id": "att-welcome",
              "kind": "text",
              "assetId": "text-welcome",
              "presentation": { "mode": "panel", "title": "Welcome" }
            },
            {
              "id": "att-hostile",
              "kind": "text",
              "assetId": "text-hostile",
              "presentation": { "mode": "panel", "title": "Hostile Input" }
            }
          ]
        }
      ],
      "zones": [
        {
          "id": "zone-spawn",
          "name": "Spawn Zone",
          "shape": { "kind": "box", "size": [8, 8, 8] },
          "position": [7, 2, 8]
        }
      ]
    }
  ],
  "rules": [
    {
      "id": "rule-welcome-on-start",
      "triggers": ["sceneStart"],
      "actions": [{ "kind": "showPanel", "params": { "attachmentId": "att-welcome" } }]

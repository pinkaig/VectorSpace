# Postgres (also consumed by docker-compose.yml)
POSTGRES_DB=vectorspace
POSTGRES_USER=vectorspace_app
POSTGRES_PASSWORD=vectorspace_local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full SQLAlchemy connection string used by apps/api. If unset, it is built
# from the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://vectorspace_app:vectorspace_local@localhost:5432/vectorspace

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=vectorspace_minio
MINIO_ROOT_PASSWORD=vectorspace_minio_local
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_BUCKET=vectorspace-media

# App
APP_ENV=local
CORS_ORIGINS=http://localhost:5173

# Auth0. NOTE: copy the API-side block below into apps/api/.env, not here.
# config.py uses pydantic-settings with env_file=".env", which resolves against the
# process working directory, and every API command runs from apps/api. Values left in
# this file are read by Vite and docker-compose only, so AUTH0_* here does nothing.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Machine-to-Machine application, authorized against the Auth0 Management API with
# create:users and create:user_tickets. Only app/provision.py uses these.
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
AUTH0_CONNECTION=Username-Password-Authentication

# Local testing without an Auth0 tenant: accept "Authorization: Bearer dev|<name>".
# The API refuses to start with this on unless APP_ENV is local or test.
AUTH_DEV_BYPASS=false

# Browser app (Vite). Leave VITE_API_URL unset to run offline with the role picker.
# Set it to sign in through the API (needs AUTH_DEV_BYPASS=true on the API in picker mode).
# VITE_API_URL=http://localhost:8000

# Auth0 in the browser. These three do NOT belong in this file: put them in .env.auth0,
# which Vite loads only for --mode auth0, i.e. "npm run dev:auth0" and "npm run build:auth0".
# All three or none: with all three set the app signs in through Auth0's hosted login and
# the role comes from GET /me; with any missing it falls back to the prototype role picker.
# Set here, every run is Auth0 mode, the picker is gone, and the Playwright suite fails,
# because the picker is what it drives. VITE_AUTH0_AUDIENCE must be the same string as
# AUTH0_AUDIENCE above, and VITE_API_URL must be set too -- there is no offline Auth0 mode.
# The deployed site is unaffected: Render passes these as real environment variables, which
# Vite reads in any mode.
#
#   npm run dev           role picker, the default   (dev| logins, needs AUTH_DEV_BYPASS)
#   npm run dev:auth0     Auth0 hosted login         (needs a provisioned roster)
#
# .env.auth0:
# VITE_AUTH0_DOMAIN=
# VITE_AUTH0_CLIENT_ID=
# VITE_AUTH0_AUDIENCE=
# Optional, but set it for a real deployment: the only connection the hosted login offers.
# Leave it unset and Auth0 shows every connection the tenant enables -- including Google,
# which signs a personal account in successfully and is then refused by GET /me, because
# provisioning only ever creates users in AUTH0_CONNECTION above. Keep the two the same, and
# turn the connections you do not want off in the tenant as well: this one only hides them.
# VITE_AUTH0_CONNECTION=Username-Password-Authentication
